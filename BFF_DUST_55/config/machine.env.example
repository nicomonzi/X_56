# Copy to config/machine.env (ignored by Git) or export these variables.
MBDYN_BIN=/usr/local/mbdyn/bin/mbdyn
DUST_BIN=/usr/local/bin/dust
DUST_PRE_BIN=/usr/local/bin/dust_pre
DUST_POST_BIN=/usr/local/bin/dust_post

# Colon-separated directories needed to import mbc_py_interface, if it is not
# already installed in the active Python environment.
MBDYN_PYTHON_PATH=
