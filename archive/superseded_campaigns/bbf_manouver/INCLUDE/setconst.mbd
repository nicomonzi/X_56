set: const real SAS_Q_REF = 0.5*RHO_AIR*(60.*m2in)*(60.*m2in);  #scalatura pressione e velocità
set: const real SAS_Q_SCALE = 1.5*SAS_Q_REF/(Q_DYN + 0.5*SAS_Q_REF);


# Il caso manovra parte geometricamente indeformato e senza pre-trim:
# assetto, superfici e coordinate elastiche iniziali sono tutti nulli.
# Il trim viene trovato nel dominio del tempo dagli integratori quota/pitch/roll/yaw.
set: const real TRIM_SCALE = (1.146e-7/RHO_AIR)*(63./V_INF)*(63./V_INF);
# Solo stima dell'assetto rigido; non introduce deformazione elastica.
set: const real TRIM_PITCH = (0.90540*TRIM_SCALE - 0.81056131 + 0.1300*(TRIM_SCALE - 1.2))*deg2rad;
set: const real TRIM_SURFACE = 0.;
set: const real LONG_TRIM_BIAS = 0.;
set: const real BODY_TRIM_CORRECTION = 0.;
set: const real BODY_TRIM_SURFACE = 0.;

set: const real TRIM_FRAME_X = X_CG - cos(TRIM_PITCH)*X_CG - sin(TRIM_PITCH)*Z_CG;
set: const real TRIM_FRAME_Y = 0.;
set: const real TRIM_FRAME_Z = Z_CG + sin(TRIM_PITCH)*X_CG - cos(TRIM_PITCH)*Z_CG;

set: const real Q_INIT_7 = 0.;
set: const real Q_INIT_8 = 0.;
set: const real Q_INIT_9 = 0.;
set: const real Q_INIT_10 = 0.;
set: const real Q_INIT_11 = 0.;
set: const real Q_INIT_12 = 0.;

