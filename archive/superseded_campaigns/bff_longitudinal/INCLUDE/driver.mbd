    drive caller: Q_DRIVE,
        element, Q_PID, loadable, string, "yout", direct;

    # Il SAS resta attivo, ma i contributi longitudinali pitch e q vengono
    # rimossi dalla banda aeroelastica prima di raggiungere i body flap.
    # Il controllo conserva quindi il contenuto lento necessario al trim,
    # senza chiudere intenzionalmente l'anello sul possibile ramo BFF.
    drive caller: PITCH_BS1_DRIVE,
        discrete filter, 2, BFF_BS1_A1, BFF_BS1_A2, BFF_BS1_B0,
            2, BFF_BS1_B1, BFF_BS1_B2, reference, PITCH_DRIVE;
    drive caller: PITCH_BS2_DRIVE,
        discrete filter, 2, BFF_BS2_A1, BFF_BS2_A2, BFF_BS2_B0,
            2, BFF_BS2_B1, BFF_BS2_B2, reference, PITCH_BS1_DRIVE;
    drive caller: PITCH_BS3_DRIVE,
        discrete filter, 2, BFF_BS3_A1, BFF_BS3_A2, BFF_BS3_B0,
            2, BFF_BS3_B1, BFF_BS3_B2, reference, PITCH_BS2_DRIVE;
    drive caller: PITCH_BFF_FREE_DRIVE,
        discrete filter, 2, BFF_BS4_A1, BFF_BS4_A2, BFF_BS4_B0,
            2, BFF_BS4_B1, BFF_BS4_B2, reference, PITCH_BS3_DRIVE;

    drive caller: Q_BS1_DRIVE,
        discrete filter, 2, BFF_BS1_A1, BFF_BS1_A2, BFF_BS1_B0,
            2, BFF_BS1_B1, BFF_BS1_B2, reference, Q_DRIVE;
    drive caller: Q_BS2_DRIVE,
        discrete filter, 2, BFF_BS2_A1, BFF_BS2_A2, BFF_BS2_B0,
            2, BFF_BS2_B1, BFF_BS2_B2, reference, Q_BS1_DRIVE;
    drive caller: Q_BS3_DRIVE,
        discrete filter, 2, BFF_BS3_A1, BFF_BS3_A2, BFF_BS3_B0,
            2, BFF_BS3_B1, BFF_BS3_B2, reference, Q_BS2_DRIVE;
    drive caller: Q_BFF_FREE_DRIVE,
        discrete filter, 2, BFF_BS4_A1, BFF_BS4_A2, BFF_BS4_B0,
            2, BFF_BS4_B1, BFF_BS4_B2, reference, Q_BS3_DRIVE;

    drive caller: SAFETY_Q_SENSOR_DRIVE,
        node, BASE_NODE, structural, string, "Omega[2]", direct;

    drive caller: SAFETY_PITCH_SENSOR_DRIVE,
        node, BASE_NODE, structural, string, "E[2]", direct;

    drive caller: SAFETY_ARM_DRIVE,
        step, SAFETY_ARM_TIME, 1., 0.;

    drive caller: SAFETY_RAW_DRIVE, string,
        "-0.35*(max(0.,model::drive(SAFETY_Q_SENSOR_DRIVE,Time)-18.*deg2rad)+min(0.,model::drive(SAFETY_Q_SENSOR_DRIVE,Time)+18.*deg2rad))-0.25*(max(0.,model::drive(SAFETY_PITCH_SENSOR_DRIVE,Time)-12.*deg2rad)+min(0.,model::drive(SAFETY_PITCH_SENSOR_DRIVE,Time)+12.*deg2rad))";
    drive caller: SAFETY_LIMIT_DRIVE, string,

        "max(-4.*deg2rad,min(4.*deg2rad,model::drive(SAFETY_RAW_DRIVE,Time)))";
    drive caller: SAFETY_ACT_DRIVE, mult,

        reference, SAFETY_ARM_DRIVE, reference, SAFETY_LIMIT_DRIVE;
    drive caller: LONG_RAW_DRIVE, array, 3,
        reference, PITCH_BFF_FREE_DRIVE, reference, Q_BFF_FREE_DRIVE,
        reference, SAFETY_ACT_DRIVE;

    drive caller: LONG_LIMIT_DRIVE, string,
        "max(-SURFACE_CORRECTION_LIMIT,min(SURFACE_CORRECTION_LIMIT,model::drive(LONG_RAW_DRIVE,Time)))";

    drive caller: LONG_ACT_DRIVE,
        discrete filter, 1, ACT_A1, ACT_B0, 1, ACT_B1,
            reference, LONG_LIMIT_DRIVE;
