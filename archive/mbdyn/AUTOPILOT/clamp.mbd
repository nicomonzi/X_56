# MBDYN AERO MODEL 

begin: data;
    problem: initial value;
end: data;

set: const integer GROUND = 0; 
set: const integer BASE_NODE = 990000;
set: const integer MODAL_JOINT = 2; 

set: const real VINF  = 25 * m2in;               # [in/s]
set: const real VBASE = 0* m2in;                # [in/s] 
set: const real ALPHA_DEG  = 7.0;                # [deg] 
set: const real ALPHA  = ALPHA_DEG * deg2rad;    # [rad]
set: const real RHO_AIR = 1.146e-7;              # [slinch/in^3]
set: const real C_SOUND = 340.0 * m2in;          # [in/s]                      

begin: initial value;
    initial time: 0.;
    final time: 5.;
    time step: 1.e-3;

    method: ms, .6;
    nonlinear solver: newton raphson, modified, 5;
    linear solver: lapack;
    tolerance: 1.e-6;
    max iterations: 20;
    
    /*
    eigenanalysis: 0.1,
        parameter, 1.e-6,
        output matrices,
        output eigenvectors,
        output geometry;
    */

    derivatives coefficient: auto;
    derivatives tolerance: 1.e-6;
    derivatives max iterations: 20;

    threads: disable;
    
    output: counter; 

end: initial value;

begin: control data;

    print: dof stats;
    skip initial joint assembly;

    structural nodes: 46;       


    aerodynamic elements: 40; 
     
    joints:2;

    gravity;
    default orientation: orientation vector;
    output results: netcdf, sync, no text;
    air properties;

end: control data;

