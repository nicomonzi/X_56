   #     reference, global, null,
   #     reference, global, null;

   structural: BASE_NODE, modal, 
        reference, global, 0.0, 0.0, 0.0,
        reference, global, eye,
        reference, global, -VBASE * cos(ALPHA), 0., VBASE * sin(ALPHA),    #clamp veloctà = 0; SIMULAZIONE CON CLAMP
