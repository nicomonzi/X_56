# MBDYN AERO MODEL 

begin: data;
    problem: initial value;
end: data;

set: const real  M2IN = 39.3700787;

set: const integer GROUND = 0; 
set: const integer BASE_NODE = 990000;
set: const integer MODAL_JOINT = 2; 

# flight variables
set: const real VINF  = 50 * M2IN;               # [in/s]
set: const real VBASE = 0 * M2IN;                # [in/s] (0 se simulato in galleria del vento con clamp)
set: const real ALPHA_DEG  = 2.0;                # [deg] 
set: const real ALPHA  = ALPHA_DEG * pi / 180.0; # [rad]
set: const real RHO_AIR = 1.146e-7;              # [slinch/in^3]
set: const real C_SOUND = 340.0 * M2IN;          # [in/s]


set: const real X_LE_ROOT = 0.0 * M2IN;
set: const real X_TE_ROOT = 2.29939 * M2IN;
set: const real X_BEAM_ROOT = 1.482862 * M2IN;
set: const real CHORD_ROOT = X_TE_ROOT - X_LE_ROOT;               
set: const real X_AC_ROOT = X_LE_ROOT + 0.25 * CHORD_ROOT;       
set: const real OFFSET_ROOT = X_AC_ROOT - X_BEAM_ROOT;

set: const real X_LE_TIP = 2.387 * M2IN;
set: const real X_TE_TIP  = 2.99344 * M2IN;
set: const real X_BEAM_TIP = 2.663113 * M2IN;
set: const real CHORD_TIP = X_TE_TIP - X_LE_TIP;                 
set: const real X_AC_TIP = X_LE_TIP + 0.25 * CHORD_TIP;         
set: const real OFFSET_TIP  = X_AC_TIP - X_BEAM_TIP;              
set: const real SPAN_ELEM   = 0.19 * M2IN;                        


begin: initial value;
    initial time: 0.;
    final time: 1;
    time step: 1.e-3;

    method: ms, .6;
    nonlinear solver: newton raphson, modified, 5;
    linear solver: lapack;
    tolerance: 1.e-6;
    max iterations: 20;

    eigenanalysis: 0.1,
        parameter, 1.e-6,
        output matrices,
        output eigenvectors,
        output geometry;

    derivatives coefficient: auto;
    derivatives tolerance: 1.e-6;
    derivatives max iterations: 20;  

    threads: disable;
end: initial value;

begin: control data;
    print: dof stats;
    skip initial joint assembly;

    structural nodes: 46;       # 1 Base Node + 45 dummy
    #joints: 2;                  # 1 Clamp + 1 Modal Joint              SIMULAZIONE CON CLAMP
    joints: 1;  

    gravity;
    default orientation: orientation vector;
    output results: netcdf;
    air properties;
    aerodynamic elements: 39;  
end: control data;

reference: GROUND,
    reference, global, null,
    reference, global, eye,
    reference, global, null,
    reference, global, null;

begin: nodes;

   # structural: BASE_NODE, modal,                                      SIMULAZIONE CON CLAMP
   #     reference, global, 0.0, 0.0, 0.0,
