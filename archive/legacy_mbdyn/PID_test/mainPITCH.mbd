begin: elements;

    #gravity: uniform, 0., 0., -1., const, GRAVITY;

    module load: "libmodule-pid";
    user defined: PID, pid,
        setpoint, step5, 2.0, 0.0, 2.2, -7.0*deg2rad, # target pitch angle [rad]
        measure, node, BASE_NODE, structural, string, "E[2]", direct,
        Kp, 5.0,
        Ki, 2.,
        Kd, 0.1,
        Kn, 100,
        Ymin, -10.* deg2rad,
        Ymax, 10.* deg2rad;

    drive caller: COLL_DRIVE, 
        array, 1, 
            element, PID, loadable, string, "yout", linear, 0., -1.;
    #joint: 1, clamp, BASE_NODE, node, node;

