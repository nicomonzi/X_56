#==================================================================================================
#         X-56 MBDyn aeroelastic model - 5 deg pitch PID test at 30 m/s.
#==================================================================================================

begin: data;
    problem: initial value;
end: data;

set: const integer GROUND = 0; 
set: const integer BFLjoint = 1; 
set: const integer BFRjoint = 2; 
set: const integer WFLjoint = 3; 
set: const integer WFRjoint = 4; 
set: const integer BASE_NODE = 990000;
set: const integer MODAL_JOINT = 5; 
set: const integer COLL_DRIVE = 50;
set: const integer COLL_DRIVE1 = 51; 
set: const integer COLL_DRIVE2 = 52;
set: const integer PID = 20;
set: const integer PITCH_RATE_PID = 21;


set: const real VINF  = 30 * m2in;               # [in/s]
set: const real ALPHA_DEG  = 0;                # [deg] 
set: const real ALPHA  = ALPHA_DEG * deg2rad;    # [rad]
set: const real RHO_AIR = 1.146e-7;              # [slinch/in^3]
set: const real C_SOUND = 340.0 * m2in;          # [in/s]            
set: const real GRAVITY = 9.81 * m2in;           # [in/s^2]          

begin: initial value;
    initial time: 0.;
    final time: 10.0;
    time step: 2.e-2;

    max iterations: 300;
	tolerance: 1e-3, test, relnorm;
	derivatives tolerance: 1;
	derivatives max iterations: 100;
	linear solver: lapack; #naive, colamd, pivot factor, 1e-1;
	method: ms, cosine, 0., pi/0.1, 0.6/2, half, 0.; #0.6 posso 0.4 smorzamento numerico 
    
    /*
    eigenanalysis: 0.1,
        parameter, 1.e-6,
        output matrices,
        output eigenvectors,
        output geometry;
    */

    output: counter; 
    #output: residual; 
    

end: initial value;

begin: control data;

    print: dof stats;
    #skip initial joint assembly;

    structural nodes: 56;       

    #abstract nodes: 10;

    #genels: 10;

    aerodynamic elements: 50; 
     
    joints:12;

    loadable elements: 2;

    # gravity;

    default orientation: orientation vector;
    output results: netcdf, sync, no text;
    air properties;

end: control data;

include: "./INCLUDE/reference.mbd";

begin: nodes;

    include: "./INCLUDE/node.mbd";

end: nodes;

begin: elements;

    # Gravity is disabled in the isolated pitch test: with only pitch free,
    # it would add a permanent moment about the pin and obscure PID tracking.
    # gravity: uniform, 0., 0., -1., const, GRAVITY;

    # PID controller for pitch angle

    /*
    module load: "libmodule-pid";
        user defined: PID, pid,
            setpoint, step5, 2.0, 0.0, 2.2, 5.0*deg2rad, # inactive roll alternative
            measure, node, BASE_NODE, structural, string, "E[1]", direct,
            Kp, 15.0,
            Ki, 10.,
            Kd, -0.5,
            Kn, 100,
            Ymin, -10.* deg2rad,
            Ymax, 10.* deg2rad;

    drive caller: COLL_DRIVE1, 
        array, 1, 
            element, PID, loadable, string, "yout", linear, 0., -1.;

    drive caller: COLL_DRIVE2, 
        array, 1, 
            element, PID, loadable, string, "yout", direct;
    */

    module load: "libmodule-pid";
        user defined: PID, pid,
            setpoint, step, 2.0, 5.0*deg2rad, 0.0,
            measure, node, BASE_NODE, structural, string, "E[2]", direct,
            Kp, 0.32,
            Ki, 0.68,
            Kd, 0.0,
            Kn, 8,
            Ymin, -7.* deg2rad,
            Ymax, 7.* deg2rad;

    # Separate rigid-body pitch-rate damper. Its contribution is summed with
    # the angle PI output, so the target remains an instantaneous step while
    # the first pitch excursion is slowed and damped.
    user defined: PITCH_RATE_PID, pid,
            setpoint, const, 0.0,
            measure, node, BASE_NODE, structural, string, "Omega[2]", direct,
            Kp, 0.2,
            Ki, 0.0,
            Kd, 0.0,
            Kn, 8,
            Ymin, -3.* deg2rad,
            Ymax, 3.* deg2rad;

    drive caller: COLL_DRIVE, 
        array, 2, 
            element, PID, loadable, string, "yout", linear, 0., -1.,
            element, PITCH_RATE_PID, loadable, string, "yout", linear, 0., -1.;

    joint: 1, total pin joint,
        BASE_NODE,
        
        position, reference, node, 160.14999390, 0.00000000, 100.16000370,
        position orientation, reference, node, eye,
        rotation orientation, reference, node, eye,
        
        position, reference, global, 160.14999390, 0.00000000, 100.16000370,
        position orientation, reference, global, eye,
        rotation orientation, reference, global, eye,
        
        position constraint, 
            active, active, active, 
            null, 
            
        orientation constraint, 
            active, inactive, active,
            null; 

    #include: "./INCLUDE/control_surface_joints.mbd";

    include: "./INCLUDE/control_surface_joints_pitch.mbd";

    include: "./INCLUDE/modaljoint.mbd";

    air properties: RHO_AIR, C_SOUND, 
        cos(ALPHA), 0., sin(ALPHA),
        #tanh, 0.0, VINF, 0.2, 0.;
        #tanh, 0.0, VINF, 0.5, 0.01;
        const, VINF;

    include: "./INCLUDE/aerobody.mbd";

end: elements;
