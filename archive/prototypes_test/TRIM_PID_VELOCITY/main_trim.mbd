#==================================================================================================
#                       X-56  MBDyn Aeroelastic Model, Nicolò Monzani.
#==================================================================================================

begin: data;
    problem: initial value;
end: data;

set: const real VELOCITY_MS = 30.0;
set: const real KI_THETA = 2.e-5;
set: const real KI_ELEVATOR = 5.e-5;
set: const real FZ_SIGN = 1.;
set: const real MY_SIGN = -1.;

set: const integer GROUND = 0;
set: const integer BFLjoint = 1;
set: const integer BFRjoint = 2;
set: const integer WFLjoint = 3;
set: const integer WFRjoint = 4;
set: const integer BASE_NODE = 990000;
set: const integer MODAL_JOINT = 5;

set: const integer TRIM_JOINT = 23;
set: const integer PID_THETA = 9101;
set: const integer PID_ELEVATOR = 9102;
set: const integer PITCH_DRIVE = 9201;
set: const integer ELEVATOR_DRIVE = 9202;

set: const real VINF = VELOCITY_MS * m2in;
set: const real DELTA_DIFF = 0.;

set: const real RHO_AIR = 1.146e-07;
set: const real C_SOUND = 340. * m2in;
set: const real GRAVITY = 9.81 * m2in;
set: const real X_CG = 163.187383385809;
set: const real Y_CG = 0.110529571088;
set: const real Z_CG = 101.239797358848;
set: const real RELEASE_TIME = 1.;
set: const real CONTROLLER_ENABLE_TIME = 1.;
set: const real CONTROLLER_ENABLE_RISE = 1.;


# MBDyn convention: y[k] = a1*y[k-1] + a2*y[k-2] + b0*u[k] + b1*u[k-1] + b2*u[k-2]
# 2nd-order Butterworth, fc = 0.5 Hz, dt = 0.02 s
set: const real BW_A1 = 1.911197067426073;
set: const real BW_A2 = -0.914975834801434;
set: const real BW_B0 = 0.;
set: const real BW_B1 = 0.000944691843840151;
set: const real BW_B2 = 0.001889383687680302;
set: const real BW_B3 = 0.000944691843840151;

begin: initial value;

    initial time: 0.;
    final time: 15.;
    time step: 0.02;

    max iterations: 300;

    tolerance: 1.e-3, test, relnorm;
    derivatives tolerance: 1.e-7;
    derivatives max iterations: 100;
    linear solver: lapack;
    method: ms, cosine, 0., pi/0.1, 0.6/2, half, 0.;

    output: counter;

end: initial value;

begin: control data;

    print: dof stats;

    tolerance: 1.e-7;

    max iterations: 100;

    initial stiffness: 1.e6, 1.e6;

    structural nodes: 56;

    aerodynamic elements: 50;

    joints: 12;

    loadable elements: 2;

    gravity;

    air properties;
    
    output results: netcdf, sync, no text;

    default orientation: orientation vector;
    output precision: 12;
end: control data;

include: "include/reference.mbd";

begin: nodes;
    include: "include/node.mbd";
end: nodes;

begin: elements;
    gravity: uniform, 0., 0., -1., const, GRAVITY;

    # The modal base remains fixed in translation.  Roll and yaw are fixed;
    # pitch is imposed by the output of PID_THETA.  The joint is located at
    # the modal reference node, close to the centre of mass.
    joint: TRIM_JOINT, total pin joint,
        BASE_NODE,
            position, reference, node, null,
            position orientation, reference, node, eye,
            rotation orientation, reference, node, eye,
        position, reference, global, X_CG, Y_CG, Z_CG,
        position orientation, reference, global, eye,
        rotation orientation, reference, global, eye,
        position constraint, active, active, active, null,
        orientation constraint, active, active, active,
            component,
                0.,
                postponed, PITCH_DRIVE,
                0.;


    module load: "libmodule-pid";

    user defined: PID_THETA, pid,
        setpoint, const, 0.,
        measure,
            discrete filter,
                2, BW_A1, BW_A2,
                BW_B0,
                3, BW_B1, BW_B2, BW_B3,
                mult,
                    step5, CONTROLLER_ENABLE_TIME, 0., CONTROLLER_ENABLE_TIME + CONTROLLER_ENABLE_RISE, 1.,
                    element, TRIM_JOINT, joint, string, "Fz",
                        linear, 0., FZ_SIGN,
        Kp, 0.,
        Ki, KI_THETA,
        Kd, 0.,
        Ii0, 0.,
        Ks, 1.,
        Ymin, -20.*deg2rad,
        Ymax, 20.*deg2rad;

    drive caller: PITCH_DRIVE,
        element, PID_THETA, loadable, string, "yout", direct;


    user defined: PID_ELEVATOR, pid,
        setpoint, const, 0.,
        measure,
            discrete filter,
                2, BW_A1, BW_A2,
                BW_B0,
                3, BW_B1, BW_B2, BW_B3,
                mult,
                    step5, CONTROLLER_ENABLE_TIME, 0., CONTROLLER_ENABLE_TIME + CONTROLLER_ENABLE_RISE, 1.,
                    element, TRIM_JOINT, joint, string, "My",
                        linear, 0., MY_SIGN,
        Kp, 0.,
        Ki, KI_ELEVATOR,
        Kd, 0.,
        Ii0, 0.,
        Ks, 1.,
        Ymin, -20.*deg2rad,
        Ymax, 20.*deg2rad;

    drive caller: ELEVATOR_DRIVE,
        element, PID_ELEVATOR, loadable, string, "yout", direct;

    include: "include/control_surfaces.mbd";

    include: "include/modaljoint.mbd";

    air properties: RHO_AIR, C_SOUND,
        1., 0., 0.,
        const, VINF;

    include: "include/aerobody.mbd";

end: elements;
