# ==============================================================================
#                       Control surface joints
# ==============================================================================    
# The left/right hinge frames are mirror images but their local hinge y axes
# have the same vertical sense.  Equal numerical commands therefore reproduce
# the symmetric trim verified by TRIM_PID_VELOCITY.

        
        
# BFL
joint: 1004, total joint,
    990004, 
        position, reference, GROUND, 160.14999390 + 12.2, -31.37999916, 101.47000120,
        position orientation, reference, node, eye,
        rotation orientation, reference, BFLjoint, eye,
    880004,
        position, reference, GROUND, 160.14999390 + 12.2, -31.37999916, 101.47000120,
        position orientation, reference, other node, eye,
        rotation orientation, reference, BFLjoint, eye,
    position constraint, 1, 1, 1, null, 
    orientation constraint, 1, 1, 1, 
    component,
        0.,
        array, 5,
            step5, 0., 0., ELEVATOR_RAMP_END, BODY_FLAP_PARTICIPATION*d_ELEVATOR,
            mult, const, BODY_FLAP_PARTICIPATION,
                reference, FLIGHT_CONTROL_DRIVE,
            mult, const, BODY_FLAP_PARTICIPATION,
                reference, PITCH_CONTROL_DRIVE,
            mult, const, BODY_FLAP_PARTICIPATION,
                reference, PITCH_RATE_DAMPER_DRIVE,
