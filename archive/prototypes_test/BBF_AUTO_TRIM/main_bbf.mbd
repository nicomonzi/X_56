# ============================================================================
# X-56: trim automatico, volo controllato e osservazione BFF nello stesso run
# ============================================================================

begin: data;
    problem: initial value;
end: data;

# Il modello MBDyn usa internamente il sistema IPS:
# lunghezze [in], velocita' [in/s], forze [lbf], momenti [lbf in].
# V_INF resta l'unico ingresso utente in SI [m/s] e viene convertito qui.
set: const real V_INF = 55.0;

set: const integer GROUND = 0;
set: const integer BFLjoint = 1;
set: const integer BFRjoint = 2;
set: const integer WFLjoint = 3;
set: const integer WFRjoint = 4;
set: const integer BASE_NODE = 990000;
set: const integer MODAL_JOINT = 5;
set: const integer TRIM_JOINT = 23;

set: const real X_CG = 163.187383385809;
set: const real Y_CG = 0.110529571088;
set: const real Z_CG = 101.239797358848;
set: const real VINF = V_INF*m2in;
set: const real RHO_AIR = 1.146e-7;
set: const real C_SOUND = 340.*m2in;
set: const real GRAVITY = 9.81*m2in;

# Sequenza del test. Il doublet inizia solo dopo trim, rilascio e assestamento.
set: const real TRIM_ENABLE_START = 1.0;
set: const real TRIM_ENABLE_END = 2.0;
# MODIFICA: tre secondi aggiuntivi permettono al transitorio flessibile
# eccitato durante la ricerca del trim di decadere prima del rilascio.
set: const real TRIM_END = 15.0;
set: const real FLIGHT_ENABLE_START = TRIM_END;
set: const real FLIGHT_ENABLE_END = TRIM_END + 1.0;
set: const real EXCITATION_START = TRIM_END + 1.5;
set: const real EXCITATION_MIDDLE = EXCITATION_START + 0.125;
set: const real EXCITATION_END = EXCITATION_START + 0.250;
set: const real BFF_WINDOW_START = EXCITATION_END;
set: const real BFF_WINDOW_END = BFF_WINDOW_START + 15.0;
# Il controllo di volo resta attivo anche nella finestra di misura.
set: const real FINAL_TIME = BFF_WINDOW_END + 1.0;

# Il doublet non assume una frequenza BFF nota a priori e agisce solo su WF4.
set: const real EXCITATION_AMPLITUDE = 0.25*deg2rad;

# Gain scheduling semplice: compensa in prima approssimazione l'efficacia
# aerodinamica proporzionale a V^2 senza introdurre tabelle di interpolazione.
set: const real GAIN_SCALE = (38./V_INF)*(38./V_INF);

# PID del trim: annullano Fz e My mentre Z e pitch sono vincolati.
set: const integer TRIM_PITCH_PID = 9101;
set: const integer TRIM_ELEVATOR_PID = 9102;
set: const integer TRIM_PITCH_LIVE_DRIVE = 9201;
set: const integer TRIM_ELEVATOR_LIVE_DRIVE = 9202;
set: const integer TRIM_PITCH_HOLD_DRIVE = 9203;
set: const integer TRIM_ELEVATOR_HOLD_DRIVE = 9204;
# Seed quasi-fisico: termine 1/q per il peso piu' offset di portanza nulla.
# Serve solo ad accelerare; Fz e My, non il seed, determinano il trim finale.
set: const real TRIM_PITCH_INITIAL = (2.75*GAIN_SCALE - 0.90)*deg2rad;
# MODIFICA: fit 1/V^2 dei trim convergenti 23--36 m/s. Un seed vicino alla
# soluzione evita la precedente corsa iniziale di circa un grado delle
# superfici, che alimentava l'oscillazione della reazione My.
set: const real TRIM_ELEVATOR_INITIAL =
    (0.37*GAIN_SCALE + 1.43)*deg2rad;
set: const real TRIM_KI_PITCH = 1.e-5*GAIN_SCALE;
# MODIFICA: il seed migliorato consente un integratore meno aggressivo.
set: const real TRIM_KI_ELEVATOR = 1.e-5*GAIN_SCALE;

# Controllo di volo: mantiene quota e assetto, ma non usa q1 o sensori alari.
# Non essendoci sensori modali, questo e' un SAS di volo e non un AFS.
set: const integer VZ_PID = 9301;
set: const integer PITCH_PID = 9303;
set: const integer PITCH_RATE_PID = 9305;
set: const integer HEAVE_PID = 9307;
set: const integer VZ_DRIVE = 9302;
set: const integer PITCH_DRIVE = 9304;
set: const integer PITCH_RATE_DRIVE = 9306;
set: const integer HEAVE_DRIVE = 9308;
set: const integer ALTITUDE_PITCH_DRIVE = 9310;
set: const integer PITCH_TARGET_DRIVE = 9311;
set: const integer ATTITUDE_RAW_DRIVE = 9312;
# Autopilota in cascata: quota/Vz producono un riferimento di pitch; il ciclo
# interno pitch/q produce la deflessione. Solo i guadagni attuatore scalano
# con 1/V^2; il riferimento geometrico quota -> pitch resta indipendente da V.
# Guadagni quota espressi in inch: sono gli equivalenti esatti dei precedenti
# 0.040 rad/m, 0.0030 rad/(m s) e 0.10 rad/(m/s).
set: const real HEAVE_KP = 0.001016;
set: const real HEAVE_KI = 0.0000762;
set: const real VZ_KP = 0.00254;
set: const real PITCH_KP = -1.20*GAIN_SCALE;
set: const real PITCH_KI = -0.12*GAIN_SCALE;
set: const real PITCH_RATE_KP = -0.35*GAIN_SCALE;

set: const integer BFF_EXCITATION_DRIVE = 9401;

# MODIFICA: Butterworth ordine 2, fc=0.25 Hz e dt=0.02 s, applicato soltanto
# alle reazioni durante il trim; non agisce sui segnali della finestra BBF.
set: const real BW_A1 = 1.955578240315035;
set: const real BW_A2 = -0.956543676511203;
set: const real BW_B0 = 0.;
set: const real BW_B1 = 0.000241359049041961;
set: const real BW_B2 = 0.000482718098083923;
set: const real BW_B3 = 0.000241359049041961;

begin: initial value;
    initial time: 0.;
    final time: FINAL_TIME;
    # MODIFICA: passo richiesto per contenere il costo dello sweep.
    time step: 0.02;
    max iterations: 300;
    tolerance: 1.e-3, test, relnorm;
    derivatives tolerance: 1.;
    derivatives max iterations: 100;
    linear solver: lapack;
    method: ms, cosine, 0., pi/0.1, 0.6/2, half, 0.;
    output: counter;
end: initial value;

begin: control data;
    print: dof stats;
    structural nodes: 56;
    aerodynamic elements: 50;
    loadable elements: 6;
    joints: 13;
    gravity;
    air properties;
    default orientation: orientation vector;
    output results: netcdf, sync, no text;
end: control data;

include: "./INCLUDE/reference.mbd";

begin: nodes;
    include: "./INCLUDE/node.mbd";
end: nodes;

begin: elements;
    gravity: uniform, 0., 0., -1., const, GRAVITY;

    # X/Y e roll/yaw restano vincolati per isolare la dinamica longitudinale.
    joint: 1, total pin joint,
        BASE_NODE,
        position, reference, node, null,
        position orientation, reference, global, eye,
        rotation orientation, reference, global, eye,
        position, reference, global, X_CG, Y_CG, Z_CG,
        position orientation, reference, global, eye,
        rotation orientation, reference, global, eye,
        position constraint, active, active, inactive, null,
        orientation constraint, active, inactive, active, null;

    # Durante il trim questo giunto trattiene soltanto Z e pitch. Al tempo
    # TRIM_END viene rimosso: heave e pitch diventano realmente liberi.
    driven: TRIM_JOINT, string, "Time < TRIM_END";
    joint: TRIM_JOINT, total pin joint,
        BASE_NODE,
        position, reference, node, null,
        position orientation, reference, global, eye,
        rotation orientation, reference, node, eye,
        position, reference, global, X_CG, Y_CG, Z_CG,
        position orientation, reference, global, eye,
        rotation orientation, reference, global, eye,
        position constraint, inactive, inactive, active, null,
        orientation constraint, inactive, active, inactive,
            component,
                0.,
                postponed, TRIM_PITCH_LIVE_DRIVE,
                0.;

    module load: "libmodule-pid";

    # Il primo integratore trova il pitch che annulla la reazione verticale.
    user defined: TRIM_PITCH_PID, pid,
        setpoint, const, 0.,
        measure,
            discrete filter,
                2, BW_A1, BW_A2,
                BW_B0,
                3, BW_B1, BW_B2, BW_B3,
                mult,
                    step5, TRIM_ENABLE_START, 0., TRIM_ENABLE_END, 1.,
                    element, TRIM_JOINT, joint, string, "Fz", direct,
        Kp, 0., Ki, TRIM_KI_PITCH, Kd, 0.,
        # Il seed 1/V^2 riduce il transitorio; il PID determina il trim finale.
        Ii0, TRIM_PITCH_INITIAL, Ks, 1.,
        Ymin, -15.*deg2rad, Ymax, 15.*deg2rad;

    drive caller: TRIM_PITCH_LIVE_DRIVE,
        mult,
            step5, 0., 0., TRIM_ENABLE_START, 1.,
            element, TRIM_PITCH_PID, loadable, string, "yout", direct;

    # Il secondo integratore trova la deflessione simmetrica che annulla My.
    user defined: TRIM_ELEVATOR_PID, pid,
        setpoint, const, 0.,
        measure,
            discrete filter,
                2, BW_A1, BW_A2,
                BW_B0,
                3, BW_B1, BW_B2, BW_B3,
                mult,
                    step5, TRIM_ENABLE_START, 0., TRIM_ENABLE_END, 1.,
                    element, TRIM_JOINT, joint, string, "My",
                        linear, 0., -1.,
        Kp, 0., Ki, TRIM_KI_ELEVATOR, Kd, 0.,
        Ii0, TRIM_ELEVATOR_INITIAL, Ks, 1.,
        Ymin, -10.*deg2rad, Ymax, 10.*deg2rad;

    drive caller: TRIM_ELEVATOR_LIVE_DRIVE,
        mult,
            step5, 0., 0., TRIM_ENABLE_START, 1.,
            element, TRIM_ELEVATOR_PID, loadable, string, "yout", direct;

    # Sample-and-hold: segue i PID durante il trim e conserva esattamente
    # l'ultimo valore quando il velivolo viene rilasciato.
    drive caller: TRIM_PITCH_HOLD_DRIVE,
        sample and hold,
            reference, TRIM_PITCH_LIVE_DRIVE,
            string, "Time < TRIM_END",
            initial value, 0.;
    drive caller: TRIM_ELEVATOR_HOLD_DRIVE,
        sample and hold,
            reference, TRIM_ELEVATOR_LIVE_DRIVE,
            string, "Time < TRIM_END",
            initial value, 0.;

    # Ciclo esterno IPS: Vz e' letta direttamente in [in/s].
    # Una discesa (Vz<0) richiede un incremento del pitch target.
    user defined: VZ_PID, pid,
        setpoint, const, 0.,
        measure, node, BASE_NODE, structural, string, "XP[3]", direct,
        Kp, VZ_KP, Ki, 0., Kd, 0.,
        Ii0, 0., Ks, 1.,
        Ymin, -4.*deg2rad, Ymax, 4.*deg2rad;
    drive caller: VZ_DRIVE,
        element, VZ_PID, loadable, string, "yout", direct;

    # PI di quota IPS: setpoint e misura sono direttamente in [in].
    # L'integrale elimina l'errore medio z-z0; anti-windup via Ks.
    user defined: HEAVE_PID, pid,
        setpoint, const, Z_CG,
        measure, node, BASE_NODE, structural, string, "X[3]", direct,
        Kp, HEAVE_KP, Ki, HEAVE_KI, Kd, 0.,
        Ii0, 0., Ks, 1.,
        Ymin, -6.*deg2rad, Ymax, 6.*deg2rad;
    drive caller: HEAVE_DRIVE,
        element, HEAVE_PID, loadable, string, "yout", direct;

    # Correzione di pitch richiesta dal ciclo esterno, inserita senza gradino.
    drive caller: ALTITUDE_PITCH_DRIVE,
        mult,
            step5, FLIGHT_ENABLE_START, 0., FLIGHT_ENABLE_END, 1.,
            array, 2,
                reference, HEAVE_DRIVE,
                reference, VZ_DRIVE;
    drive caller: PITCH_TARGET_DRIVE,
        array, 2,
            reference, TRIM_PITCH_HOLD_DRIVE,
            reference, ALTITUDE_PITCH_DRIVE;

    # Ciclo interno: segue trim+correzione di quota usando il pitch rigido.
    user defined: PITCH_PID, pid,
        setpoint, reference, PITCH_TARGET_DRIVE,
        measure, node, BASE_NODE, structural, string, "E[2]", direct,
        Kp, PITCH_KP, Ki, PITCH_KI, Kd, 0.,
        Ii0, 0., Ks, 1.,
        Ymin, -8.*deg2rad, Ymax, 8.*deg2rad;
    drive caller: PITCH_DRIVE,
        element, PITCH_PID, loadable, string, "yout", direct;

    # Rate damper del solo corpo rigido: nessun q1 o sensore di bending.
    user defined: PITCH_RATE_PID, pid,
        setpoint, const, 0.,
        measure, node, BASE_NODE, structural, string, "Omega[2]", direct,
        Kp, PITCH_RATE_KP, Ki, 0., Kd, 0.,
        Ii0, 0., Ks, 1.,
        Ymin, -4.*deg2rad, Ymax, 4.*deg2rad;
    drive caller: PITCH_RATE_DRIVE,
        element, PITCH_RATE_PID, loadable, string, "yout", direct;

    # Unico comando attuatore: PI di pitch + damper q, abilitato dolcemente.
    drive caller: ATTITUDE_RAW_DRIVE,
        mult,
            step5, FLIGHT_ENABLE_START, 0., FLIGHT_ENABLE_END, 1.,
            array, 2,
                reference, PITCH_DRIVE,
                reference, PITCH_RATE_DRIVE;

    # Doublet rettangolare: +A per 0.125 s, poi -A per 0.125 s, infine zero.
    drive caller: BFF_EXCITATION_DRIVE,
        array, 2,
            double step, EXCITATION_START, EXCITATION_MIDDLE,
                EXCITATION_AMPLITUDE, 0.,
            double step, EXCITATION_MIDDLE, EXCITATION_END,
                -EXCITATION_AMPLITUDE, 0.;

    include: "./INCLUDE/control_surfaces.mbd";
    include: "./INCLUDE/modaljoint.mbd";

    air properties: RHO_AIR, C_SOUND,
        1., 0., 0.,
        const, VINF;
    include: "./INCLUDE/aerobody.mbd";
end: elements;
