# Filter coefficients regenerated for dt; gains are DUST tuning seeds.
set: const real SAS_Q_REF = 0.5*RHO_AIR*(60.*m2in)*(60.*m2in);  
set: const real SAS_Q_SCALE = 1.5*SAS_Q_REF/(Q_DYN + 0.5*SAS_Q_REF);


set: const real TRIM_SCALE = (1.146e-7/RHO_AIR)*(63./V_INF)*(63./V_INF);



set: const real TRIM_PITCH = (
    -4.52589945e-05*V_INF*V_INF*V_INF
    +9.90399208e-03*V_INF*V_INF
    -7.64540531e-01*V_INF
    +2.10173790e+01)*deg2rad;
set: const real TRIM_SURFACE = -0.32834*TRIM_SCALE*deg2rad;
set: const real LONG_TRIM_BIAS = 0.*deg2rad;
set: const real BODY_TRIM_CORRECTION = 0.*deg2rad;
set: const real BODY_TRIM_SURFACE = 0.03593*TRIM_SCALE*deg2rad;

set: const real TRIM_FRAME_X =  X_CG - cos(TRIM_PITCH)*X_CG - sin(TRIM_PITCH)*Z_CG;
set: const real TRIM_FRAME_Y = 0.;
set: const real TRIM_FRAME_Z = Z_CG + sin(TRIM_PITCH)*X_CG - cos(TRIM_PITCH)*Z_CG;

set: const real Q_INIT_7 = -5.033945862198e-01 + 1.616213139584e-05*V_INF*V_INF - 3.2850e-02*TRIM_SCALE;
set: const real Q_INIT_8 = -2.562292005110e-03 - 3.306551722320e-09*V_INF*V_INF + 1.5170e-03*TRIM_SCALE;
set: const real Q_INIT_9 = -2.428866391792e-02 + 1.644734988211e-07*V_INF*V_INF - 5.1500e-04*TRIM_SCALE;
set: const real Q_INIT_10 = 5.354679238553e-02 - 1.961594597194e-06*V_INF*V_INF + 2.8260e-03*TRIM_SCALE;
set: const real Q_INIT_11 = -1.206861316869e-02 + 1.029764665218e-06*V_INF*V_INF - 9.0000e-06*TRIM_SCALE;
set: const real Q_INIT_12 = -7.936600053275e-05 + 7.471808861059e-08*V_INF*V_INF - 4.8000e-05*TRIM_SCALE;





