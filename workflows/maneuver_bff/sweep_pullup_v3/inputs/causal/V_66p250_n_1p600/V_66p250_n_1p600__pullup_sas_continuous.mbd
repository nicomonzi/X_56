set: const real SAS_Q_REF = 0.5*RHO_AIR*(60.*m2in)*(60.*m2in);  #scalatura pressione e velocità
set: const real SAS_Q_SCALE = 1.5*SAS_Q_REF/(Q_DYN + 0.5*SAS_Q_REF);


set: const real TRIM_SCALE = (1.146e-7/RHO_AIR)*(63./V_INF)*(63./V_INF);
# Physical aeroelastic pitch reached after closed-loop convergence.  Unlike
# surface end states, attitude contains no controller-integrator contribution
# and is therefore safe to use as the scheduled pitch reference (50--70 m/s).
set: const real TRIM_PITCH = (
    -4.52589945e-05*V_INF*V_INF*V_INF
    +9.90399208e-03*V_INF*V_INF
    -7.64540531e-01*V_INF
    +2.10173790e+01)*deg2rad;
set: const real TRIM_SURFACE = -0.32834*TRIM_SCALE*deg2rad;
set: const real LONG_TRIM_BIAS = 0.*deg2rad;
set: const real BODY_TRIM_CORRECTION = 0.*deg2rad;
set: const real BODY_TRIM_SURFACE = 0.03593*TRIM_SCALE*deg2rad;

set: const real TRIM_FRAME_X =  X_CG - cos(TRIM_PITCH)*X_CG - sin(TRIM_PITCH)*Z_CG;
set: const real TRIM_FRAME_Y = 0.;
set: const real TRIM_FRAME_Z = Z_CG + sin(TRIM_PITCH)*X_CG - cos(TRIM_PITCH)*Z_CG;

set: const real Q_INIT_7 = -5.033945862198e-01 + 1.616213139584e-05*V_INF*V_INF - 3.2850e-02*TRIM_SCALE;
set: const real Q_INIT_8 = -2.562292005110e-03 - 3.306551722320e-09*V_INF*V_INF + 1.5170e-03*TRIM_SCALE;
set: const real Q_INIT_9 = -2.428866391792e-02 + 1.644734988211e-07*V_INF*V_INF - 5.1500e-04*TRIM_SCALE;
set: const real Q_INIT_10 = 5.354679238553e-02 - 1.961594597194e-06*V_INF*V_INF + 2.8260e-03*TRIM_SCALE;
set: const real Q_INIT_11 = -1.206861316869e-02 + 1.029764665218e-06*V_INF*V_INF - 9.0000e-06*TRIM_SCALE;
set: const real Q_INIT_12 = -7.936600053275e-05 + 7.471808861059e-08*V_INF*V_INF - 4.8000e-05*TRIM_SCALE;

# Values rendered by run_case.py from a documented 50--70 m/s schedule.
# Modal mass is unity in mbdyn_modal.fem.  Positive K7/C7 reduce the
# sectional model's effective modal stiffness/damping and recover the
# released NASTRAN SOL 145 point-7 trend.  They are not SAS gains.
set: const real NASTRAN_DLM_ROM_K7 = 1.4850000000e+02;
set: const real NASTRAN_DLM_ROM_C7 = 9.8350000000e+00;
set: const real NASTRAN_DLM_ROM_Q7_EQ = -4.1967439005e-01;
set: const real NASTRAN_DLM_ROM_RAMP_TIME = 5.;
set: const integer NASTRAN_DLM_ROM_FORCE = 9501;

set: const real LP_A1 = 1.946697540756184e+00;
set: const real LP_A2 = -9.480817061067398e-01;
set: const real LP_B0 = 3.460413376391039e-04;
set: const real LP_B1 = 6.920826752782078e-04;
set: const real LP_B2 = 3.460413376391039e-04;

# First-order low-pass filters at dt=0.01 s: altitude 0.15 Hz, Vz and q 1 Hz.
# The former Vz cutoff of 0.35 Hz added excessive phase lag to the flight-path
# mode and prevented the aircraft from becoming stationary before release.
set: const real ALT_LP_A1 = 9.906193578364677e-01;
set: const real ALT_LP_B0 = 4.690321081766102e-03;
set: const real ALT_LP_B1 = 4.690321081766102e-03;
set: const real VZ_LP_A1 = 9.390625058174924e-01;
set: const real VZ_LP_B0 = 3.046874709125383e-02;
set: const real VZ_LP_B1 = 3.046874709125383e-02;
set: const real Q_LP_A1 = 9.390625058174924e-01;
set: const real Q_LP_B0 = 3.046874709125383e-02;
set: const real Q_LP_B1 = 3.046874709125383e-02;

# Attuatori Tustin del primo ordine, tau=0.01 s e dt=0.01 s.
set: const real ACT_A1 = 3.333333333333334e-01;
set: const real ACT_B0 = 3.333333333333334e-01;
set: const real ACT_B1 = 3.333333333333334e-01;
set: const real SURFACE_CORRECTION_LIMIT = 8.*deg2rad;
# Il mantenimento della traiettoria usa le superfici alari interne con una
# banda molto piu' bassa del BFF durante settling e recupero. I suoi stati
# continuano a evolvere, ma l'uscita al plant e' congelata durante SAS-off.
set: const real LIFT_HOLD_GAIN = -0.58;
set: const real LIFT_CORRECTION_LIMIT = 4.*deg2rad;
# Closed-loop-only generalized damping.  A value of 60 destabilized the
# coupled rigid/flexible settling transient at 65 m/s; 16 completed the same
# case without dominating the flight-path controller.
set: const real SAS_MODAL_DAMPING = 2.4000000000e+01;


