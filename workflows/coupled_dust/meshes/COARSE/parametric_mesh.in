mesh_file_type = parametric
el_type = p

! DUST receives structural kinematics and returns aerodynamic loads through preCICE.
coupled = T
coupling_type = rbf
coupling_node_file = model/dust/coupling_nodes.in
! Lightweight qualitative aerodynamic mesh: not for quantitative convergence.
! Nine nominal chordwise divisions produce 18 panels around the 3-D airfoil.
nelem_chord = 5
type_chord = cosineLE
reference_chord_fraction = 0.0
! The original DUST mesh is translated into the global IPS frame used by MBDyn.
starting_point = (/ 100.0, 0.0, 100.16000370 /)

mesh_symmetry =T
symmetry_point= (/0.0, 0.0, 0.0/)
symmetry_normal= (/0.0, -1.0, 0.0/)

n_hinges = 10

hinge = {
hinge_tag = BFR
hinge_nodes_input = parametric
node_1 = (/ 76.52569045, 16.8300, 0.0 /)
node_2 = (/ 64.96848785, 45.9300, 0.0 /)
n_nodes = 2
hinge_ref_dir = (/ 1.0, 0.0, 0.0 /)
hinge_adaptive_mesh = F
hinge_offset = 0.05
hinge_spanwise_blending = 0.05
hinge_rotation_input = coupling
hinge_rotation_coupling = {
coupling_node_subset = range
coupling_node_first = 40
coupling_node_last = 41
}
}

