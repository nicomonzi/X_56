joint: MODAL_JOINT, modal, 
        BASE_NODE, 
        # Con dt=0.01 s la frequenza di Nyquist e' 50 Hz. Si
        # mantengono i modi elastici FEM 7--12 (3.217--12.759 Hz). E' una
        # conservano almeno 7.8 campioni per il modo piu' alto e oltre 30
        # campioni/ciclo per SWB1; i modi FEM 1--6 sono i 6 DOF rigidi gia'
        # rappresentati dal BASE_NODE.
        6,
        list, 7, 8, 9, 10, 11, 12,
        # Deformata statica di trim. I coefficienti sono fit lineari in V^2
        # dei trim convergenti 55/58/60.8421 m/s; qP=0 evita un impulso
        # elastico artificiale al primo passo. Le sei coordinate richieste
        # corrispondono ai modi FEM 7--12, non ai modi rigidi esclusi.
        initial value,
            mode, 7, Q_INIT_7, 0.,
            mode, 8, Q_INIT_8, 0.,
            mode, 9, Q_INIT_9, 0.,
            mode, 10, Q_INIT_10, 0.,
            mode, 11, Q_INIT_11, 0.,
            mode, 12, Q_INIT_12, 0.,
        8527,             
        single factor damping, 0.01,                           
        # FEM validato conservato nello stesso INCLUDE: il caso resta
        # eseguibile anche se le vecchie cartelle di lavoro vengono spostate.
        "mbdyn_modal.fem",
        origin position, X_CG, Y_CG, Z_CG,
        45,                                       
            990001,      990001,    null, 
            990002,      990002,    null,
            990003,      990003,    null,
            990004,      990004,    null,
            990005,      990005,    null,
