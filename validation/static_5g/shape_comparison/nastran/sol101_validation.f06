0                                                                                                                                   
0                                        C A S E    C O N T R O L    E C H O                                                        
                 COMMAND                                                                                                            
                 COUNT                                                                                                              
                  1      $                                                                                       
                  2      TITLE=X-56A - VALIDAZIONE STATICA MBDYN/NASTRAN                                         
                  3      SUBTITLE=STESSI NODI, VINCOLI E CARICHI DEL MODELLO MODALE MBDYN                        
                  4      ECHO=NONE                                                                               
                  5      $                                                                                       
                  6      $ --- CONDIZIONI AL CONTORNO E CARICHI GLOBALI ---                                      
                  7      SPC = 3                                                                                 
                  8      $                                                                                       
                  9      $ --- RICHIESTE DI OUTPUT GLOBALI ---                                                   
                 10      SET 101 = 990001 THRU 990023, 991002 THRU 991023                                        
                 11      DISPLACEMENT(PLOT) = ALL                                                                
                 12      SPCFORCES(PLOT) = ALL                                                                   
                 13      $                                                                                       
                 14      $ --- DEFINIZIONE DEI SUBCASE (TEST MATRICE) ---                                        
                 15      SUBCASE 1                                                                               
                 16        LABEL = CASE1 SYMMETRIC BENDING - 10 LBF DOWN PER TIP                                 
                 17        LOAD = 101                                                                            
                 18        DISPLACEMENT(PRINT) = 101                                                             
                 19      SUBCASE 2                                                                               
                 20        LABEL = CASE2 ANTISYMMETRIC BENDING - PLUS/MINUS 10 LBF                               
                 21        LOAD = 102                                                                            
                 22        DISPLACEMENT(PRINT) = 101                                                             
                 23      SUBCASE 3                                                                               
                 24        LABEL = CASE3 SYMMETRIC TORSION - 500 LBF-IN PER TIP                                  
                 25        LOAD = 103                                                                            
                 26        DISPLACEMENT(PRINT) = 101                                                             
                 27      $                                                                                       
                 28      BEGIN BULK                                                                              
