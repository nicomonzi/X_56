NASTRAN Q4TAPER=0.7,T3SKEW=3.0
INIT MASTER(S)
ASSIGN OUTPUT2='sol101_validation.op2', UNIT=12
$
SOL 101
TIME 4000
DIAG 8
CEND
$
TITLE=X-56A - VALIDAZIONE STATICA MBDYN/NASTRAN
SUBTITLE=STESSI NODI, VINCOLI E CARICHI DEL MODELLO MODALE MBDYN
ECHO=NONE
$
$ --- CONDIZIONI AL CONTORNO E CARICHI GLOBALI ---
SPC = 3
$
$ --- RICHIESTE DI OUTPUT GLOBALI ---
SET 101 = 990001 THRU 990023, 991002 THRU 991023
DISPLACEMENT(PLOT) = ALL
SPCFORCES(PLOT) = ALL
$
$ --- DEFINIZIONE DEI SUBCASE (TEST MATRICE) ---
SUBCASE 1
  LABEL = CASE1 SYMMETRIC BENDING - 10 LBF DOWN PER TIP
  LOAD = 101
  DISPLACEMENT(PRINT) = 101
SUBCASE 2
  LABEL = CASE2 ANTISYMMETRIC BENDING - PLUS/MINUS 10 LBF
  LOAD = 102
  DISPLACEMENT(PRINT) = 101
SUBCASE 3
  LABEL = CASE3 SYMMETRIC TORSION - 500 LBF-IN PER TIP
  LOAD = 103
  DISPLACEMENT(PRINT) = 101
$
BEGIN BULK
