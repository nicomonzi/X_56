$$  Identico vincolo MBDyn: clamp al nodo centrale/radice 990001.
$$
SPC,3,990001,123456,0.0
$$
$$  CASE 1: flessione simmetrica, 10 lbf verso -Z su ciascun tip.
$$
FORCE,101,990020,0,10.0,0.0,0.0,-1.0
FORCE,101,991020,0,10.0,0.0,0.0,-1.0
$$
$$  CASE 2: flessione antisimmetrica, sinistra -Z e destra +Z.
$$
FORCE,102,990020,0,10.0,0.0,0.0,-1.0
FORCE,102,991020,0,10.0,0.0,0.0,1.0
$$
$$  CASE 3: torsione simmetrica, 500 lbf-in concordi attorno a Y globale.
$$
MOMENT,103,990020,0,500.0,0.0,1.0,0.0
MOMENT,103,991020,0,500.0,0.0,1.0,0.0
