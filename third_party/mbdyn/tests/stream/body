# $Header: /var/cvs/mbdyn/mbdyn/mbdyn-1.0/tests/stream/body,v 1.11 2017/03/27 13:43:24 masarati Exp $

begin: data;
	problem: initial value;
end: data;

begin: initial value;
	initial time: 0.;
	final time: 10.;
	time step: 1.e-3;

	# method: ms, .6;
	method: bdf;

	tolerance: 1.e-6;
	max iterations: 10;

	linear solver: naive, colamd, mt, 1;

	threads: disable;
	# output: iterations;
threads: disable;
end: initial value;

begin: control data;
	structural nodes: 1;
	rigid bodies: 1;
	forces: 1;
	file drivers: 1;
	output elements: 1;

	select timeout: 1;
end: control data;

set: integer NODE = 100;
set: integer INPUT = 200;
set: integer BODY = 300;
set: integer FORCE = 400;
set: integer OUTPUT = 500;

begin: nodes;
	structural: NODE, dynamic,
		reference, global, null,
		reference, global, eye,
		reference, global, 1.,0.,0.,
		reference, global, null;
end: nodes;

begin: drivers;
	file: INPUT, stream,
                stream drive name, "SPRNGF",
                create, yes,
                # path, "./mbdyn.spring.sock",
                port, 8005,
		# nonblocking,
		socket type, udp,
		# socket type, tcp,
		timeout, 5.,
		echo, "body-in.echo",
                1;	# force
end: drivers;

begin: elements;
	body: BODY, NODE,
		1.,
		null,
		eye;
	force: FORCE, absolute,
		NODE,
			position, reference, node, null,
			single, reference, global, 1.,0.,0.,
		file, INPUT, 1;
	# stream output: OUTPUT,
	# output element: OUTPUT, socket stream,
	stream output: OUTPUT,
		# send after, convergence,
                stream name, "BODYXV",
                # create, yes,
		create, no,
                # path, "./mbdyn.body.sock",
                port, 10011,
		socket type, udp,
		echo, "body-out.echo",
                values, 2,
                        drive, node, NODE, structural, string, "X[1]", direct,	# ch 1: x
                        drive, node, NODE, structural, string, "XP[1]", direct;	# ch 2: dot_x
end: elements;

